<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.StackActivityTest">

        <activity
            android:name=".ui.ActivityA"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.example.stackactivitytest.taskA"

        android:showWhenLocked="true"
        android:turnScreenOn="true">

        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

    <activity
        android:name=".ui.ActivityB"
        android:exported="false"
        android:taskAffinity="com.example.stackactivitytest.taskB" />

    <activity
        android:name=".ui.ActivityC"
        android:exported="false"
        android:taskAffinity="com.example.stackactivitytest.taskB" />
    <receiver
        android:name=".WakeReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="com.example.stackactivitytest.WAKE_A" />
        </intent-filter>
    </receiver>

</application>
    </manifest>
